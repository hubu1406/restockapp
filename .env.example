# Database connection string
# Local dev (SQLite): DATABASE_URL="file:./dev.db"
# Production (Vercel/Neon Postgres): DATABASE_URL="postgresql://user:pass@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL="file:./dev.db"

# Your primary Shopify store domain
DEFAULT_SHOP_DOMAIN="your-store.myshopify.com"

# Shopify Webhook HMAC signing secret
SHOPIFY_WEBHOOK_SECRET="your_shopify_webhook_secret"

# Resend Email API (https://resend.com)
RESEND_API_KEY="re_xxxxxxxxx"
RESEND_FROM_EMAIL="Alerts <alerts@yourdomain.com>"
